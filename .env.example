# FalkorDB
FALKORDB_HOST=localhost
FALKORDB_PORT=6379
FALKORDB_PASSWORD=
FALKORDB_GRAPH=graphguard

# LLM Provider: "anthropic" | "openai" | "demo"
LLM_PROVIDER=demo
LLM_API_KEY=
LLM_MODEL=claude-3-5-haiku-20241022

# Backend
BACKEND_HOST=0.0.0.0
BACKEND_PORT=8000

# Tenant
DEFAULT_TENANT_ID=tenant_default

# Demo mode (true = no LLM calls, deterministic workflow)
DEMO_MODE=true
